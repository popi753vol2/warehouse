{
  "name": "warehouse",
  "version": "1.0.0",
  "description": "Welcome to your new CAP project.",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "project1": "cds watch --open project1/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@cap-js/sqlite": "^3.0.2",
    "@sap/cds": "^10.0.6"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": "db.sqlite"
        }
      },
      "auth": {
        "strategy": "mock",
        "users": {
          "Admin": {
            "roles": [
              "Admin"
            ]
          },
          "Manager": {
            "roles": [
              "Manager"
            ]
          },
          "John Smith": {
            "roles": [
              "Customer"
            ]
          }
        }
      }
    }
  },
  "workspaces": [
    "app/*"
  ],
  "devDependencies": {
    "cds-plugin-ui5": "^0.17.0",
    "@sap/ux-specification": "^1.144.11"
  },
  "sapux": [
    "app/project1"
  ]
}

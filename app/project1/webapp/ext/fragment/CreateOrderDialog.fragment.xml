<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form">
    <Dialog
        id="createOrderDialog"
        title="Create Order"
        contentWidth="550px">
        <content>
            <VBox class="sapUiSmallMargin" id="createOrderDialogContent">
                <form:SimpleForm id="_IDGenSimpleForm"
                    editable="true"
                    layout="ResponsiveGridLayout"
                    labelSpanXL="4"
                    labelSpanL="4"
                    labelSpanM="4"
                    labelSpanS="12">
                    <form:content>
                        <Label id="_IDGenLabel" text="Customer" required="true"/>
                        <ComboBox
                            id="customerComboBox"
                            items="{/Customers}"
                            selectedKey="{orderConfig>/customer_ID}"
                            placeholder="Select customer">
                            <core:Item id="_IDGenItem" key="{ID}" text="{name}"/>
                        </ComboBox>

                        <Label id="_IDGenLabelCurrency" text="Currency" required="true"/>
                        <ComboBox
                            id="currencyComboBox"
                            items="{/Currencies}"
                            selectedKey="{orderConfig>/currency_code}"
                            placeholder="Select currency">
                            <core:Item id="_IDGenItemCurrency" key="{code}" text="{name}"/>
                        </ComboBox>

                        <Label id="_IDGenLabel1" text="Order Date"/>
                        <DatePicker
                            id="orderDatePicker"
                            value="{orderConfig>/orderDate}"
                            valueFormat="yyyy-MM-dd"
                            displayFormat="medium"/>
                    </form:content>
                </form:SimpleForm>

                <Title id="_IDGenTitle" text="Selected Products" class="sapUiSmallMarginTop sapUiTinyMarginBottom" level="H5"/>
                <Table
                    id="selectedProductsTable"
                    items="{orderItems>/}">
                    <columns>
                        <Column id="_IDGenColumn">
                            <Text id="_IDGenText12" text="Product Name"/>
                        </Column>
                        <Column id="_IDGenColumn1" width="160px" hAlign="End">
                            <Text id="_IDGenText1" text="Quantity"/>
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem id="_IDGenColumnListItem">
                            <cells>
                                <Text id="_IDGenText2" text="{orderItems>name}"/>
                                <StepInput id="_IDGenStepInput"
                                    value="{orderItems>quantity}"
                                    min="1"
                                    max="9999"
                                    step="1"
                                    width="130px"/>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </content>
        <beginButton>
            <Button id="_IDGenButton1" text="Confirm Order" type="Emphasized" press=".onConfirmOrder"/>
        </beginButton>
        <endButton>
            <Button id="_IDGenButton2" text="Cancel" press=".onCancelOrder"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>
